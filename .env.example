# LeanScope Agent Kit — the "batteries", for clients that read them from the environment: Copilot
# CLI, VS Code *Copilot* sessions, Codex, Cursor (and VS Code Local sessions with `--secrets env`).
# Claude Code and VS Code *Local* sessions ask for them instead. Use exactly these names.
# Put these in YOUR environment (shell profile, direnv, a secrets manager) and restart the editor.
# This file is a list of names only: no MCP client reads a project `.env`.
# Never commit real values, never paste them into a chat.

# Your LeanScope personal team-repos access token. It names the repository your choreos live in.
# Go to https://app.leanscope.ai/ to get your personal team-repos access token via your account avatar button (top-right corner).
LEANSCOPE_PERSONAL_TEAM_REPOS_ACCESS_TOKEN=

# Your own LLM keys — sent to the agent server per session, held in memory only, never stored.
# At least one completion-model key is needed to run a choreo; OpenAI also powers live voice calls.
LEANSCOPE_OPENAI_API_KEY=
LEANSCOPE_ANTHROPIC_API_KEY=
LEANSCOPE_MISTRAL_API_KEY=
LEANSCOPE_ELEVENLABS_API_KEY=
