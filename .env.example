# LeanScope Agent Kit — the "batteries". Put these in YOUR environment (shell profile, direnv, a
# secrets manager). Never commit real values, never paste them into a chat.

# Your LeanScope repository access token. It names the repository your choreos live in.
LEANSCOPE_PERSONAL_TEAM_REPOS_ACCESS_TOKEN=

# Your own LLM keys — sent to the agent server per session, held in memory only, never stored.
# At least one completion-model key is needed to run a choreo; OpenAI also powers live voice calls.
LEANSCOPE_OPENAI_API_KEY=
LEANSCOPE_ANTHROPIC_API_KEY=
LEANSCOPE_MISTRAL_API_KEY=
LEANSCOPE_ELEVENLABS_API_KEY=
