{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "inputs": [
    {
      "type": "promptString",
      "id": "leanscope-token",
      "description": "LeanScope personal team repos access token. Get it at https://app.leanscope.ai/ via your avatar (top-right). It names the repository your choreos live in.",
      "password": true
    },
    {
      "type": "promptString",
      "id": "leanscope-openai",
      "description": "OpenAI API key. Needed by most choreos and for voice calls. Leave empty if you have none yet.",
      "password": true
    }
  ],
  "mcpServers": {
    "leanscope-admin": {
      "type": "streamable-http",
      "url": "https://dev.mcp.leanscope.ai/mcp/admin",
      "headers": {
        "Authorization": "Bearer ${input:leanscope-token}"
      }
    },
    "leanscope-graphql": {
      "type": "streamable-http",
      "url": "https://dev.mcp.leanscope.ai/mcp/graphql-v2",
      "headers": {
        "Authorization": "Bearer ${input:leanscope-token}"
      }
    },
    "leanscope-agents": {
      "type": "streamable-http",
      "url": "https://dev.mcp.leanscope.ai/mcp/agents",
      "headers": {
        "Authorization": "Bearer ${input:leanscope-token}",
        "X-LeanScope-Key-OpenAI": "${input:leanscope-openai}"
      }
    }
  }
}
